{
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Envoy active health check per cluster. <100% means a worker is down or drained (low disk).",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 7,
    "h": 9
   },
   "id": 1,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "orientation": "horizontal"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "min by (envoy_cluster_name) (${prefix}envoy_cluster_membership_healthy{envoy_cluster_name!=\"sched\"} / ${prefix}envoy_cluster_membership_total{envoy_cluster_name!=\"sched\"})",
     "legendFormat": "{{envoy_cluster_name}}",
     "refId": "A"
    }
   ],
   "title": "Healthy workers",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Running builds over build slots per system, as the active scheduler sees it.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 7,
    "y": 0,
    "w": 7,
    "h": 9
   },
   "id": 2,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name",
    "minVizWidth": 110,
    "maxPerRow": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"running\"})) / (sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"slots\"})) > 0)",
     "legendFormat": "{{system}}",
     "refId": "A",
     "instant": true
    }
   ],
   "title": "Build slots busy",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 10,
    "h": 3
   },
   "id": 3,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "built",
     "expr": "sum(increase(${prefix}nix_grpc_events_total{kind=\"built\"}[1h]))",
     "instant": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "failed",
     "expr": "sum(increase(${prefix}nix_grpc_events_total{kind=\"build_failed\"}[1h])) > 0",
     "instant": true
    }
   ],
   "title": "Builds (last hour)",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Derivations waiting for a free slot on the serving scheduler. unplaceable: no connected worker offers the system or features.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 20
       },
       {
        "color": "red",
        "value": 200
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "unplaceable"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
    "x": 14,
    "y": 3,
    "w": 10,
    "h": 3
   },
   "id": 4,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "queued",
     "expr": "max(${prefix}nix_grpc_sched{kind=\"queued\"})",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "unplaceable",
     "expr": "sum(max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"unplaceable\"})) > 0",
     "instant": true,
     "range": false
    }
   ],
   "title": "Queued",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "The node holding the scheduler lock. No leader: builds wait up to restart-grace.",
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "noValue": "no leader",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "leader"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "gridPos": {
    "x": 14,
    "y": 6,
    "w": 10,
    "h": 3
   },
   "id": 14,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "instant": true,
     "range": false,
     "legendFormat": "{{instance}}{{host}}",
     "expr": "max by ($instance) (${prefix}nix_grpc_sched{kind=\"leader\"}) == 1"
    }
   ],
   "title": "Scheduler",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "fillOpacity": 40,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "id": 24,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}} queued",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"queued\"})) > 0"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}} unplaceable",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"unplaceable\"})) > 0"
    }
   ],
   "title": "Queue length per system",
   "type": "timeseries",
   "description": "Summed over feature sets on the serving scheduler. Systems with nothing queued, running or free are hidden. Per feature set: nix_grpc_sched_system in Explore."
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "15 minute window.",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "noValue": "no builds in range",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "id": 15,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (system, le) (rate(${prefix}nix_grpc_queue_seconds_bucket[15m])))",
     "legendFormat": "{{system}}",
     "refId": "A"
    }
   ],
   "title": "Queue wait p95 by system",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "fillOpacity": 80,
      "lineWidth": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "slot utilisation (right)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "max",
        "value": 1
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "custom.drawStyle",
        "value": "line"
       },
       {
        "id": "custom.lineWidth",
        "value": 2
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       },
       {
        "id": "custom.stacking",
        "value": {
         "mode": "none"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "id": 5,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(${prefix}nix_grpc_events_total{kind=\"built\"}[5m])) * 60",
     "legendFormat": "built",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "avg(sum by ($instance) (${prefix}nix_grpc_inflight{kind=\"BuildDerivation\"}) / sum by ($instance) (${prefix}nix_grpc_build_slots))",
     "legendFormat": "slot utilisation (right)",
     "refId": "B"
    }
   ],
   "title": "Builds / min and slot use",
   "type": "timeseries",
   "description": "Fleet slot utilisation on the right axis."
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Inputs are the store paths a build needs. Local means already on the worker, fetched means pulled from a substituter first.",
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "noValue": "no builds in range",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "id": 16,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(${prefix}nix_grpc_build_inputs_total{state=\"fetched\"}[5m])) / sum(rate(${prefix}nix_grpc_build_inputs_total[5m]))",
     "legendFormat": "share of input paths fetched",
     "refId": "A"
    }
   ],
   "title": "Share of build input paths fetched",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Substitute phase of BuildDerivation, p50 and p95.",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {}
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "id": 7,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{method=\"BuildDerivation\",phase=\"substitute\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{method=\"BuildDerivation\",phase=\"substitute\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "title": "Input fetch per build",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "niks3 + object store upload after a build or client upload. The main fixed cost per build.",
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "id": 8,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{phase=\"publish\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{phase=\"publish\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "title": "Publish to cache latency",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "NAR bytes the workers pulled from the cache to satisfy build inputs, by worker.",
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0,
     "custom": {
      "fillOpacity": 25,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "id": 18,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(${prefix}nix_grpc_build_input_bytes_total[5m]))",
     "legendFormat": "fleet",
     "refId": "A"
    }
   ],
   "title": "Input bytes fetched from the cache",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Over the selected time range.",
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "id": 23,
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showUnfilled": true,
    "namePlacement": "top"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sort_desc(topk(10, sum by ($instance) (increase(${prefix}nix_grpc_build_input_bytes_total[$__range]))))",
     "legendFormat": "{{instance}}{{host}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "title": "Bytes fetched by worker (top 10)",
   "type": "bargauge",
   "transformations": [
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "Value",
        "desc": true
       }
      ]
     }
    }
   ]
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Failed builds by Nix failure status. PermanentFailure is the derivation itself. TransientFailure and TimedOut can succeed on a retry.",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      }
     },
     "unit": "short",
     "noValue": "no failures in range"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 12,
    "h": 8
   },
   "id": 19,
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (reason) (rate(${prefix}nix_grpc_build_failures_total[$__rate_interval]))",
     "legendFormat": "{{reason}}",
     "refId": "A"
    }
   ],
   "title": "Build failures / min by reason",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "All of these should be ~0. unexpected_build/expect_no_show: client and scheduler disagree on where a build goes (advertise address wrong, or a node restarted). input_not_substitutable: a build input was in no cache and not uploaded by the client.",
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "noValue": "0",
     "custom": {
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "fillOpacity": 80,
      "lineWidth": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "5xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "connect failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "health check failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "scheduler anomalies"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
