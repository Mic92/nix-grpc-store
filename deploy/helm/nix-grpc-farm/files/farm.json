{
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Envoy active health check per cluster. <100% means a worker is down or drained (low disk).",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "${prefix}envoy_cluster_membership_healthy / ${prefix}envoy_cluster_membership_total",
     "legendFormat": "{{envoy_cluster_name}}",
     "refId": "A"
    }
   ],
   "title": "Healthy workers",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Sustained ~100% means builds queue (see slot_wait). Add workers or raise maxJobs.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "id": 2,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(${prefix}nix_grpc_inflight{kind=\"BuildDerivation\"}) / sum(${prefix}nix_grpc_build_slots)",
     "legendFormat": "farm",
     "refId": "A"
    }
   ],
   "title": "Build slots busy",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "id": 3,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(${prefix}nix_grpc_events_total{kind=\"built\"}[5m])) * 60",
     "legendFormat": "built",
     "refId": "A"
    }
   ],
   "title": "Builds / min",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Derivations whose builder failed. Usually the package, not the farm.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "id": 4,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(${prefix}nix_grpc_events_total{kind=\"build_failed\"}[5m])) * 60",
     "legendFormat": "failed",
     "refId": "A"
    }
   ],
   "title": "Failed builds / min",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "id": 5,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by ($instance,kind) (rate(${prefix}nix_grpc_events_total{kind=~\"built|build_failed\"}[5m])) * 60",
     "legendFormat": "{{instance}}{{host}} {{kind}}",
     "refId": "A"
    }
   ],
   "title": "Builds / min by worker",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "max": 1,
     "min": 0,
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "id": 6,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by ($instance) (${prefix}nix_grpc_inflight{kind=\"BuildDerivation\"}) / sum by ($instance) (${prefix}nix_grpc_build_slots)",
     "legendFormat": "{{instance}}{{host}}",
     "refId": "A"
    }
   ],
   "title": "Build slot utilisation by worker",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Seconds added to every build besides the build itself. publish = upload outputs to the cache, substitute = fetch inputs.",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      }
     },
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "id": 7,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (phase) (rate(${prefix}nix_grpc_phase_seconds_sum{method=\"BuildDerivation\",phase=~\"substitute|publish\"}[$__rate_interval])) / ignoring(phase) group_left sum(rate(${prefix}nix_grpc_phase_seconds_count{method=\"BuildDerivation\",phase=\"build\"}[$__rate_interval]))",
     "legendFormat": "{{phase}}",
     "refId": "A"
    }
   ],
   "title": "Per-build overhead by phase (farm mean)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "niks3 + object store upload after a build or client upload. The main fixed cost per build.",
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "id": 8,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{phase=\"publish\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{phase=\"publish\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "title": "Publish to cache latency",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "ms"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "active.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "id": 9,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le,${prefix}envoy_cluster_name) (rate(${prefix}envoy_cluster_upstream_rq_time_bucket[$__rate_interval])))",
     "legendFormat": "p95 {{envoy_cluster_name}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (${prefix}envoy_cluster_name) (${prefix}envoy_cluster_upstream_rq_active)",
     "legendFormat": "active {{envoy_cluster_name}}",
     "refId": "B"
    }
   ],
   "title": "Load balancer: p95 request time and active requests",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "All of these should be ~0. unexpected_build/expect_no_show: client and scheduler disagree on where a build goes (advertise address wrong, or a node restarted). input_not_substitutable: a build input was in no cache and not uploaded by the client.",
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "id": 10,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (${prefix}envoy_cluster_name) (rate(${prefix}envoy_cluster_upstream_rq_xx{envoy_response_code_class=\"5\"}[5m])) * 60",
     "legendFormat": "5xx/min {{envoy_cluster_name}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (${prefix}envoy_cluster_name) (rate(${prefix}envoy_cluster_upstream_cx_connect_fail[5m])) * 60",
     "legendFormat": "connect fail/min {{envoy_cluster_name}}",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (${prefix}envoy_cluster_name) (rate(${prefix}envoy_cluster_health_check_failure[5m])) * 60",
     "legendFormat": "health check fail/min {{envoy_cluster_name}}",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by ($instance,kind) (rate(${prefix}nix_grpc_events_total{kind=~\"unexpected_build|expect_no_show|expect_undeliverable|input_not_substitutable\"}[5m])) * 60",
     "legendFormat": "{{kind}}/min {{instance}}{{host}}",
     "refId": "D"
    }
   ],
   "title": "Errors",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "min": 0,
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 28
   },
   "id": 11,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (${prefix}nix_grpc_sched)",
     "legendFormat": "{{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "title": "Scheduler: queued, workers, clients",
   "type": "timeseries"
  }
 ],
 "refresh": "30s",
 "schemaVersion": 39,
 "tags": [
  "nix",
  "farm"
 ],
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "timezone": "browser",
 "title": "Nix build farm",
 "uid": "nix-farm",
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Datasource",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0
   },
   {
    "name": "instance",
    "label": "Worker label",
    "type": "textbox",
    "query": "instance",
    "current": {
     "text": "instance",
     "value": "instance"
    },
    "hide": 0,
    "description": "Label that tells workers apart: `instance` for a plain Prometheus scrape, `host` for telegraf/agent setups."
   },
   {
    "name": "prefix",
    "label": "Metric prefix",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "hide": 0,
    "description": "Prepended to metric names, e.g. prometheus_ when scraped through telegraf."
   }
  ]
 },
 "links": [
  {
   "targetBlank": true,
   "title": "docs",
   "type": "link",
   "url": "https://github.com/Mic92/nix-grpc-store/blob/main/docs/farm.md"
  }
 ]
}
