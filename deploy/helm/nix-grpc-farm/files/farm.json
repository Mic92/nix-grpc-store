{
 "panels": [
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Envoy active health check per cluster. <100% means a worker is down or drained (low disk).",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "${prefix}envoy_cluster_membership_healthy{envoy_cluster_name!=\"sched\"} / ${prefix}envoy_cluster_membership_total{envoy_cluster_name!=\"sched\"}",
     "legendFormat": "{{envoy_cluster_name}}",
     "refId": "A"
    }
   ],
   "title": "Healthy workers",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Sustained ~100% means builds queue (see slot_wait). Add workers or raise maxJobs.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "id": 2,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(${prefix}nix_grpc_inflight{kind=\"BuildDerivation\"}) / sum(${prefix}nix_grpc_build_slots)",
     "legendFormat": "farm",
     "refId": "A"
    }
   ],
   "title": "Build slots busy",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "id": 3,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "built",
     "expr": "sum(rate(${prefix}nix_grpc_events_total{kind=\"built\"}[5m])) * 60"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "failed",
     "expr": "sum(rate(${prefix}nix_grpc_events_total{kind=\"build_failed\"}[5m])) * 60 > 0"
    }
   ],
   "title": "Builds / min",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Derivations waiting for a free slot on the serving scheduler. unplaceable: no connected worker offers the system or features.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 20
       },
       {
        "color": "red",
        "value": 200
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "unplaceable"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "id": 4,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "queued",
     "expr": "max(${prefix}nix_grpc_sched{kind=\"queued\"})",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "unplaceable",
     "expr": "sum(max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"unplaceable\"})) > 0",
     "instant": true,
     "range": false
    }
   ],
   "title": "Queued",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "id": 5,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by ($instance,kind) (rate(${prefix}nix_grpc_events_total{kind=~\"built|build_failed\"}[5m])) * 60",
     "legendFormat": "{{instance}}{{host}} {{kind}}",
     "refId": "A"
    }
   ],
   "title": "Builds / min by worker",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "max": 1,
     "min": 0,
     "unit": "percentunit"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "id": 6,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by ($instance) (${prefix}nix_grpc_inflight{kind=\"BuildDerivation\"}) / sum by ($instance) (${prefix}nix_grpc_build_slots)",
     "legendFormat": "{{instance}}{{host}}",
     "refId": "A"
    }
   ],
   "title": "Build slot utilisation by worker",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Seconds added to every build besides the build itself. publish = upload outputs to the cache, substitute = fetch inputs.",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      }
     },
     "unit": "s",
     "noValue": "no builds in range"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "id": 7,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (phase) (rate(${prefix}nix_grpc_phase_seconds_sum{method=\"BuildDerivation\",phase=~\"substitute|publish\"}[$__rate_interval])) / ignoring(phase) group_left sum(rate(${prefix}nix_grpc_phase_seconds_count{method=\"BuildDerivation\",phase=\"build\"}[$__rate_interval]))",
     "legendFormat": "{{phase}}",
     "refId": "A"
    }
   ],
   "title": "Per-build overhead by phase (farm mean)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "niks3 + object store upload after a build or client upload. The main fixed cost per build.",
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "id": 8,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{phase=\"publish\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(${prefix}nix_grpc_phase_seconds_bucket{phase=\"publish\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "title": "Publish to cache latency",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "ms"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "open.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 28
   },
   "id": 9,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, envoy_cluster_name) (rate(${prefix}envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name!=\"sched\"}[$__rate_interval])))",
     "legendFormat": "p95 {{envoy_cluster_name}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (envoy_cluster_name) (${prefix}envoy_cluster_upstream_rq_active)",
     "legendFormat": "open {{envoy_cluster_name}}",
     "refId": "B"
    }
   ],
   "title": "Load balancer: p95 request time per worker cluster, open streams",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "All of these should be ~0. unexpected_build/expect_no_show: client and scheduler disagree on where a build goes (advertise address wrong, or a node restarted). input_not_substitutable: a build input was in no cache and not uploaded by the client.",
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "noValue": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 28
   },
   "id": 10,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (envoy_cluster_name) (rate(${prefix}envoy_cluster_upstream_rq_xx{envoy_response_code_class=\"5\",envoy_cluster_name!=\"sched\"}[5m])) * 60 > 0",
     "legendFormat": "5xx/min {{envoy_cluster_name}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (envoy_cluster_name) (rate(${prefix}envoy_cluster_upstream_cx_connect_fail{envoy_cluster_name!=\"sched\"}[5m])) * 60 > 0",
     "legendFormat": "connect fail/min {{envoy_cluster_name}}",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (envoy_cluster_name) (rate(${prefix}envoy_cluster_health_check_failure{envoy_cluster_name!=\"sched\"}[5m])) * 60 > 0",
     "legendFormat": "health check fail/min {{envoy_cluster_name}}",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by ($instance,kind) (rate(${prefix}nix_grpc_events_total{kind=~\"unexpected_build|expect_no_show|expect_undeliverable|input_not_substitutable\"}[5m])) * 60 > 0",
     "legendFormat": "{{kind}}/min {{instance}}{{host}}",
     "refId": "D"
    }
   ],
   "title": "Errors",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "min": 0,
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "id": 12,
   "options": {
    "legend": {
     "calcs": [],
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}} queued",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"queued\"})) > 0"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}} unplaceable",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"unplaceable\"})) > 0"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}} running",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"running\"})) > 0"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}} free",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"free\"})) > 0"
    }
   ],
   "title": "Queue and free slots by system",
   "type": "timeseries",
   "description": "Summed over feature sets on the serving scheduler. Systems with nothing queued, running or free are hidden. Per feature set: nix_grpc_sched_system in Explore."
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "min": 0,
     "unit": "short"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "id": 11,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{kind}}",
     "expr": "max by (kind) (${prefix}nix_grpc_sched{kind=~\"workers|clients\"} and on ($instance) (${prefix}nix_grpc_sched{kind=\"leader\"} == 1))"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "leader {{instance}}{{host}}",
     "expr": "max by ($instance) (${prefix}nix_grpc_sched{kind=\"leader\"}) == 1"
    }
   ],
   "title": "Scheduler: workers and clients on the leader",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "Build slots no build occupies, per system, as the serving scheduler sees them.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "id": 13,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "legendFormat": "{{system}}",
     "expr": "sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"free\"})) > 0 or sum by (system) (max by (system, features) (${prefix}nix_grpc_sched_system{kind=\"running\"}) > 0) * 0",
     "instant": true,
     "range": false
    }
   ],
   "title": "Free slots",
   "type": "stat"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "description": "The node holding the scheduler lock. No leader: builds wait up to restart-grace.",
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "noValue": "no leader",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "leader"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "id": 14,
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "instant": true,
     "range": false,
     "legendFormat": "{{instance}}{{host}}",
     "expr": "max by ($instance) (${prefix}nix_grpc_sched{kind=\"leader\"}) == 1"
    }
   ],
   "title": "Scheduler",
   "type": "stat"
  }
 ],
 "refresh": "30s",
 "schemaVersion": 39,
 "tags": [
  "nix",
  "farm"
 ],
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "timezone": "browser",
 "title": "Nix build farm",
 "uid": "nix-farm",
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Datasource",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0
   },
   {
    "name": "instance",
    "label": "Worker label",
    "type": "textbox",
    "query": "instance",
    "current": {
     "text": "instance",
     "value": "instance"
    },
    "hide": 0,
    "description": "Label that tells workers apart: `instance` for a plain Prometheus scrape, `host` for telegraf/agent setups."
   },
   {
    "name": "prefix",
    "label": "Metric prefix",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "hide": 0,
    "description": "Prepended to metric names, e.g. prometheus_ when scraped through telegraf."
   }
