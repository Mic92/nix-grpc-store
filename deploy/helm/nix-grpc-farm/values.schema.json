{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "niks3",
    "workers"
  ],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "lbImage": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "niks3": {
      "type": "object",
      "properties": {
        "serverURL": {
          "type": "string"
        },
        "cacheURL": {
          "type": "string"
        },
        "publicKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^:]+:[A-Za-z0-9+/=]+$"
          }
        },
        "pushFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "serviceAccountToken": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "audience": {
                  "type": "string"
                },
                "expirationSeconds": {
                  "type": "integer",
                  "minimum": 600
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "clientCA": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lb": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "accessRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cn": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "read-only",
                  "write",
                  "trusted"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "cn",
              "role"
            ]
          }
        },
        "anonymousRole": {
          "anyOf": [
            {
              "enum": [
                "read-only",
                "write",
                "trusted"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workloadIdentity": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowedServiceAccounts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^:]+:[^:]+$"
              }
            },
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "read",
                  "write",
                  "admin"
                ]
              }
            },
            "audience": {
              "type": "string"
            },
            "issuer": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "oidcProviders": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "workerDefaults": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^([a-z0-9_]+-[a-z0-9]+)?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 1
        },
        "cores": {
          "type": "integer",
          "minimum": 0
        },
        "minFree": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?[KMGT%]?$"
        },
        "store": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "buildDir": {
          "type": "object",
          "properties": {
            "medium": {
              "enum": [
                "",
                "Memory"
              ]
            },
            "sizeLimit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "extraNixConf": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "daemonResources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "deploymentAnnotations": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "minAvailable": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "pattern": "^([a-z0-9_]+-[a-z0-9]+)?$"
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "maxJobs": {
            "type": "integer",
            "minimum": 1
          },
          "cores": {
            "type": "integer",
            "minimum": 0
          },
          "minFree": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?[KMGT%]?$"
          },
          "store": {
            "type": "object",
            "properties": {
              "sizeLimit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "buildDir": {
            "type": "object",
            "properties": {
              "medium": {
                "enum": [
                  "",
                  "Memory"
                ]
              },
              "sizeLimit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "extraNixConf": {
            "type": "string"
          },
          "resources": {
            "type": "object"
          },
          "daemonResources": {
            "type": "object"
          },
          "nodeSelector": {
            "type": "object"
          },
          "tolerations": {
            "type": "array"
          },
          "affinity": {
            "type": "object"
          },
          "topologySpreadConstraints": {
            "type": "array"
          },
          "priorityClassName": {
            "type": "string"
          },
          "deploymentAnnotations": {
            "type": "object"
          },
          "podAnnotations": {
            "type": "object"
          },
          "podLabels": {
            "type": "object"
          },
          "extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraEnv": {
            "type": "array"
          },
          "extraVolumes": {
            "type": "array"
          },
          "extraVolumeMounts": {
            "type": "array"
          },
          "podDisruptionBudget": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "maxUnavailable": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "minAvailable": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
      }
    },
    "defaultGroup": {
      "type": "string"
    },
    "gc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ensureFree": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?[KMGT%]?$"
        },
        "interval": {
          "type": "integer",
          "minimum": 10
        },
        "keepRecent": {
          "type": [
            "string",
            "null"
          ]
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "upstreamCaches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "logLevel": {
      "enum": [
        "info",
        "debug"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "lb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxStreams": {
          "type": "integer",
          "minimum": 1
        },
        "healthCheckInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)$"
        },
        "accessLog": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer"
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ]
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "deploymentAnnotations": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "minAvailable": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "grafanaDashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
